# ============================================================
# Shell / terminal UX
# ============================================================

brew "fish"
brew "starship"

# Node.js version management
brew "fnm"

# ============================================================
# Development
# ============================================================

# Editor
brew "neovim"

# C / C++ build tooling
#
# Apple Clang, make, lldb, etc. come from Apple's
# Command Line Tools and are intentionally NOT installed
# through Homebrew.
brew "cmake"
brew "ninja"
brew "pkg-config"

# LLVM provides clangd, clang-format, clang-tidy, etc.
#
# It is keg-only because macOS already provides LLVM tools.
brew "llvm"

# Python
brew "uv"

# Rust toolchain manager
brew "rustup"

